{
  "name": "lekhjs-parity",
  "version": "0.0.0",
  "private": true,
  "description": "Porting-only tools: the difference register, the C++ oracle comparisons and golden regeneration (spec 01 §7). Not exported, never bundled; src/ may not import it.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "fixtures": "node json/fixtures.mjs",
    "compare": "node json/compare.mjs",
    "report": "node json/report.mjs",
    "scrub-check": "node json/scrub-check.mjs",
    "register:check": "node register/check.mjs",
    "register:index": "node tools/register-index.mjs",
    "lock": "node tools/lock.mjs"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "yaml": "2.8.1"
  }
}
